<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: widgets and Linux reaching 192.168.x and other local addresses. Asked for
         from a row in settings (LocalNetwork.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Speech input for the agent prompt bar; only recognized text reaches Linux. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Contacts in the bar's search (search/ContactSearch.kt): opt-in, asked for only when settings › search turns them on. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Uninstall from the app drawer's long-press menu (ACTION_DELETE). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Swiping down on home can pull down the notification shade (StatusBar.kt). A normal permission, no prompt. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Android 15+: the private space's apps, on the drawer's private tab while it's unlocked
         (AndroidApps.kt). A normal permission, granted at install; Android shows the space only to
         the default home app, which must keep its apps out of sight, search included, while it's
         locked. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Widgets' android.location and android.steps, each asked for only from a tap on a widget that
         uses it (permission(...) in owl, WidgetPermissions.kt). Coarse only: a city for the weather. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Focus mode and app timers (focus/): today's screen time per app, a special access the user grants in
         Android's settings, asked for only by a timer or a widget that shows it; and Do Not Disturb while a focus
         profile asks for it, once the user lets the launcher switch it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Scheduled agent jobs (jobs/Jobs.kt): an alarm on time through Doze (Android 13+ asks the user, from the jobs
         screen), set again after a reboot, the CPU kept awake while a job's agent runs, and whether it's on Wi-Fi for
         jobs that wait for it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets settings("output") see whether the phone's System UI has Android's output switcher. -->
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_MEDIA_OUTPUT_DIALOG" />
        </intent>
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_SYSTEM_MEDIA_OUTPUT_DIALOG" />
        </intent>
        <!-- Lets SpeechRecognizer find the phone's recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Icon packs (IconPacks.kt) declare themselves with another launcher's theme, as an action or as a category of MAIN. -->
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.THEMES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.adw.launcher.icons.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="com.motorola.launcher3.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.motorola.launcher3.THEME" />
        </intent>
        <intent>
            <action android:name="com.sonymobile.home.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.sonymobile.home.THEME" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Omalauncher"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A widget shared as a link or QR code: https://simonschubert.github.io/omarchy-widgets/w#owl1.<data> (widgets/market/Share.kt). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="simonschubert.github.io" android:pathPrefix="/omarchy-widgets/w" />
            </intent-filter>
        </activity>

        <!-- Asks before an app pins a shortcut to home (ShortcutManager.requestPinShortcut); browsers only install
             websites when the home app has this. Its own task, so the system's CLEAR_TASK never touches home's,
             gone once left. Not exported: the system starts it, and other apps have no reason to. -->
        <activity
            android:name=".PinShortcutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Binds a widget from one of the phone's apps for home and shows its settings (AddWidgetActivity.kt); no window
             of its own. Its own task, like PinShortcutActivity's. -->
        <activity
            android:name=".AddWidgetActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog" />

        <!-- "Add as SSH key" in the share sheet (SshKeyShareActivity.kt): disabled until the SSH server is turned on
             (linux/Ssh.kt), so other shares don't offer it. -->
        <activity
            android:name=".SshKeyShareActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/ssh_share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-pem-file" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LinuxWindowActivity"
            android:label="@string/activity_linux"
            android:theme="@style/Theme.Omalauncher.Window"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />

        <!-- Recents names a task after its activity's manifest label, so the common windows get their own. -->
        <activity-alias
            android:name=".TerminalWindow"
            android:exported="false"
            android:label="@string/activity_terminal"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".BtopWindow"
            android:exported="false"
            android:label="btop"
            android:targetActivity=".LinuxWindowActivity" />

        <!-- And each coding agent (Agent.windowAlias), with its logo: Recents shows the activity's icon too. -->
        <activity-alias
            android:name=".ClaudeWindow"
            android:exported="false"
            android:icon="@drawable/agent_claude"
            android:label="Claude Code"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OpencodeWindow"
            android:exported="false"
            android:icon="@drawable/agent_opencode"
            android:label="OpenCode"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CodexWindow"
            android:exported="false"
            android:icon="@drawable/agent_codex"
            android:label="Codex"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".GrokWindow"
            android:exported="false"
            android:icon="@drawable/agent_grok"
            android:label="Grok"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CopilotWindow"
            android:exported="false"
            android:icon="@drawable/agent_copilot"
            android:label="GitHub Copilot"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CrushWindow"
            android:exported="false"
            android:icon="@drawable/agent_crush"
            android:label="Crush"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".CursorAgentWindow"
            android:exported="false"
            android:icon="@drawable/agent_cursor_agent"
            android:label="Cursor CLI"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".AgyWindow"
            android:exported="false"
            android:icon="@drawable/agent_agy"
            android:label="Antigravity"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".PiWindow"
            android:exported="false"
            android:icon="@drawable/agent_pi"
            android:label="Pi"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OmpWindow"
            android:exported="false"
            android:icon="@drawable/agent_omp"
            android:label="Oh My Pi"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".OriWindow"
            android:exported="false"
            android:icon="@drawable/agent_ori"
            android:label="Ori"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".MuseWindow"
            android:exported="false"
            android:icon="@drawable/agent_muse"
            android:label="Muse Code"
            android:targetActivity=".LinuxWindowActivity" />

        <activity-alias
            android:name=".KimiWindow"
            android:exported="false"
            android:icon="@drawable/agent_kimi"
            android:label="Kimi"
            android:targetActivity=".LinuxWindowActivity" />

        <!-- The tiling desktop for Linux windows (desktop/Desktop.kt), on a monitor or on a large screen; each start is
             a task of its own, and the one before it goes. While this is the home app, Android also starts it as the
             home of a display that gets a launcher of its own (SECONDARY_HOME), which must not be singleTask. -->
        <activity
            android:name=".desktop.DesktopActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:label="@string/desktop_title"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.desktop"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- One task per owl app, named after it; launched with its file name in the intent's data. -->
        <activity
            android:name=".OwlAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:label="@string/activity_app"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:icon="@drawable/files"
            android:label="@string/activity_files"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:label="@string/activity_settings"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.settings"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <!-- One task per file, named after it; launched with the file in the intent's data. -->
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:icon="@drawable/editor"
            android:label="@string/editor_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Omalauncher.Window"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".theme.OmarchyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Notification access lets widgets show and control what's playing (android.media) and list notifications (android.notifications). -->
        <service
            android:name=".widgets.runtime.MediaListener"
            android:exported="true"
            android:label="@string/notification_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Other apps (Tasker, Home Assistant) set values in widgets with a `source x = external`
             (widgets/ExternalValues.kt). Disabled until the user allows it in settings, which enables it. -->
        <receiver
            android:name=".widgets.SetValueReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.omalauncher.pp.action.SET" />
            </intent-filter>
        </receiver>

        <!-- A coding agent session's notification (AgentStatus.kt): tapping it opens the session's terminal, without a
             window of its own; Allow, Deny and dismissing it go to the receiver. -->
        <activity
            android:name=".AgentSessionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <receiver
            android:name=".AgentStatusReceiver"
            android:exported="false" />

        <!-- Off until the user turns it on: home's gestures lock the screen and open recent apps with it (GestureAccessibility.kt). -->
        <service
            android:name=".GestureAccessibility"
            android:exported="true"
            android:label="@string/gesture_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_accessibility" />
        </service>

        <!-- Focus mode's time's-up screen, in place of an app it leaves out or one whose time is up; out of Recents. -->
        <activity
            android:name=".focus.TimesUpActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.timesup"
            android:theme="@style/Theme.Omalauncher.Window" />

        <!-- Opt-in, from settings › focus: focus mode and app timers for apps opened outside the launcher. -->
        <service
            android:name=".focus.FocusGuard"
            android:exported="true"
            android:label="@string/focus_guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_guard" />
        </service>

        <!-- The jobs' alarm, and what makes Android drop it (a reboot, an update) or changes what its time means. Only the
             system sends these; nothing else may start a job. -->
        <receiver
            android:name=".jobs.JobReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started Linux environment and its display server" />
        </service>

        <!-- Linux apps' notifications (LinuxNotifications.kt): a swipe or a button goes back to the app on the
             guest's session bus, a tap brings its window back. The tap is an activity of its own task that shows
             nothing, since only an activity a notification opened may bring another task to the front. -->
        <receiver
            android:name=".LinuxNotifications$Receiver"
            android:exported="false" />

        <activity
            android:name=".LinuxNotifications$TapActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog" />

        <!-- Quick settings tiles (tiles/TileServices.kt). Active tiles: Android binds them when QuickTiles.watch asks, on
             every change of Linux's state, rather than each time the shade opens. -->
        <service
            android:name=".tiles.LinuxTile"
            android:exported="true"
            android:icon="@drawable/qs_linux"
            android:label="@string/qs_tiles_linux"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.TerminalTile"
            android:exported="true"
            android:icon="@drawable/qs_terminal"
            android:label="@string/qs_tiles_terminal"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".tiles.AgentTile"
            android:exported="true"
            android:icon="@drawable/qs_agent"
            android:label="@string/qs_tiles_ask"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- The Linux tile's "shut down?" while Linux windows are open; only the dialog shows. -->
        <activity
            android:name=".tiles.LinuxPowerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Omalauncher.Dialog" />

        <!-- A long press on a tile: its page in settings. Exported for System UI; it only opens settings. -->
        <activity
            android:name=".tiles.TileSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
    </application>
</manifest>
