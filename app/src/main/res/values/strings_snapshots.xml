    <string name="snapshots_restore_body">Linux shuts down, goes back to how it was then and starts again: packages installed or updated since go back too. /root and /home stay as they are.</string>
    <string name="snapshots_restore_body_home">Linux shuts down, goes back to how it was then and starts again: packages installed or updated since go back too, and so do /root and /home. Files changed there since are lost.</string>
