panel "app drawer" {
  // The app drawer: swiping up on home opens it, above the prompt bar. It's a panel like any other, so it's yours to
  // change: ask your agent to edit it, or pick another panel in settings › gestures. .stock-drawer.owl next to it is
  // this file as the launcher ships it, kept up to date: compare the two to see what changed in a newer launcher.
  meta { description: "The launcher's app drawer, written in owl: your apps by kind, search as you type in the prompt bar, and each app's long-press menu"; version: "1.2"; license: "MIT"; category: "system"; owl: 16 }
  // The launcher's gear, as its settings buttons draw it; currentColor takes the accent.
  asset gear = base64""
  // What the drawer says, in the phone's language where it has a set, and in English where it doesn't. The action
  // words (pin, info, ...) are appAction's, so a long-press menu names each with get(str, word).
  strings {
    en {
      personal: "personal"; work: "work"; apps: "apps"; linux: "linux"; shortcuts: "shortcuts"; android: "android"
      workApps: "work apps"; workPaused: "work apps paused"; linuxApps: "linux apps"
      pin: "add to home"; info: "app info"; uninstall: "uninstall"; remove: "remove"; edit: "edit"; share: "share"
      settings: "settings"; turnOn: "turn on"; pause: "pause"; installing: "installing…"; installLinux: "install linux"
      open: "open"; ask: "ask"; askInstallLinux: "ask an agent · install linux"; askInstallAgent: "ask an agent · install one"
      askAgent: (bin, text) => "ask ${bin}: ${text}"
      private: "private"; privateApps: "private apps"; privateLocked: "private space locked"; privateSpace: "private space"
      widgets: "widgets"; install: "install"; lock: "lock"; unlock: "unlock"; unlockPrivate: "unlock private space"; hideWhileLocked: "hide while locked"
      shownOn: "on"; shownOff: "off"; startLinux: "start linux"
    }
    id {
      personal: "pribadi"; work: "kerja"; apps: "aplikasi"; linux: "linux"; shortcuts: "pintasan"; android: "android"
      workApps: "aplikasi kerja"; workPaused: "aplikasi kerja dijeda"; linuxApps: "aplikasi linux"
      pin: "tambah ke layar utama"; info: "info aplikasi"; uninstall: "uninstal"; remove: "hapus"; edit: "edit"; share: "bagikan"
      settings: "setelan"; turnOn: "aktifkan"; pause: "jeda"; installing: "menginstal…"; installLinux: "instal linux"
      open: "buka"; ask: "tanya"; askInstallLinux: "tanya agen · instal linux"; askInstallAgent: "tanya agen · instal satu"
      askAgent: (bin, text) => "tanya ${bin}: ${text}"
      private: "privat"; privateApps: "aplikasi privat"; privateLocked: "ruang privat terkunci"; privateSpace: "ruang privat"
      widgets: "widget"; install: "instal"; lock: "kunci"; unlock: "buka kunci"; unlockPrivate: "buka kunci ruang privat"; hideWhileLocked: "sembunyikan saat terkunci"
      shownOn: "aktif"; shownOff: "nonaktif"; startLinux: "mulai linux"
    }
    es {
      personal: "personal"; work: "trabajo"; apps: "apps"; linux: "linux"; shortcuts: "accesos directos"; android: "android"
      workApps: "apps de trabajo"; workPaused: "apps de trabajo en pausa"; linuxApps: "apps de linux"
      pin: "agregar a inicio"; info: "info de la app"; uninstall: "desinstalar"; remove: "quitar"; edit: "editar"; share: "compartir"
      settings: "configuración"; turnOn: "activar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "preguntar"; askInstallLinux: "preguntar a un agente · instalar linux"; askInstallAgent: "preguntar a un agente · instalar uno"
      askAgent: (bin, text) => "preguntar a ${bin}: ${text}"
      private: "privado"; privateApps: "apps privadas"; privateLocked: "espacio privado bloqueado"; privateSpace: "espacio privado"
      widgets: "widgets"; install: "instalar"; lock: "bloquear"; unlock: "desbloquear"; unlockPrivate: "desbloquear espacio privado"; hideWhileLocked: "ocultar al bloquear"
      shownOn: "sí"; shownOff: "no"; startLinux: "iniciar linux"
    }
    pt {
      personal: "pessoal"; work: "trabalho"; apps: "apps"; linux: "linux"; shortcuts: "atalhos"; android: "android"
      workApps: "apps de trabalho"; workPaused: "apps de trabalho pausados"; linuxApps: "apps linux"
      pin: "adicionar à tela inicial"; info: "informações do app"; uninstall: "desinstalar"; remove: "remover"; edit: "editar"; share: "compartilhar"
      settings: "configurações"; turnOn: "ativar"; pause: "pausar"; installing: "instalando…"; installLinux: "instalar linux"
      open: "abrir"; ask: "perguntar"; askInstallLinux: "perguntar a um agente · instalar linux"; askInstallAgent: "perguntar a um agente · instalar um"
      askAgent: (bin, text) => "perguntar ao ${bin}: ${text}"
      private: "privado"; privateApps: "apps privados"; privateLocked: "espaço privado bloqueado"; privateSpace: "espaço privado"
      widgets: "widgets"; install: "instalar"; lock: "bloquear"; unlock: "desbloquear"; unlockPrivate: "desbloquear espaço privado"; hideWhileLocked: "ocultar quando bloqueado"
      shownOn: "ativado"; shownOff: "desativado"; startLinux: "iniciar linux"
    }
  }
  source d = android.drawer
  source ag = android.agents
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  // The result picked with the arrow or Tab keys, -1 for the ask row; null follows the ranking.
  state pick = null
  // The letter picked on the rail, null for every app (the launcher sets it back to null as the drawer closes, so it
  // opens on every app again); and whether a finger is on the rail.
  state railLetter = null
  state railTouch = false

  // How big icons draw and whether names go under them, as style.toml's icons.size and icons.drawer-labels say.
  let scale = d.iconSize ?? 1
  let labels = d.labels ?? true
  // As the launcher's drawer fits them: a column for every 76 dp, wider for big icons, beside the letter rail.
  let railWidth = 28
  let cols = max(1, floor(((screenWidth ?? 400) - 24 - railWidth) / max(76, 52 * scale + 24)))
  let typed = trim(query)
  let searching = typed != ""
  // The private space's tab shows while it's there, unless it's locked and hidden while locked: then only typing
  // "private" offers to unlock it. Locked, its apps aren't listed at all, here or in search.
  let tabs = flatten([["personal"], d.work != null ? ["work"] : [], d.private != null && !(d.private.locked && d.private.hidden) ? ["private"] : []])
  // A tab that went away (the space locked and hid) leaves the personal one.
  let shown = contains(tabs, tab) ? tab : "personal"
  let tabApps = d.apps.filter(a => shown == "personal" ? a.profile != "work" && a.profile != "private" : a.profile == shown)
  // The letter rail, as Niagara's: each app goes under its first letter, 0 for a digit and # for anything else.
  let firsts = tabApps.map(a => merge(a, {first: lower(sub(trim(a.name), 0, 1))}))
  let bucketed = firsts.map(a => merge(a, {bucket: a.first != "" && contains("0123456789", a.first) ? "0" : upper(a.first) != a.first ? a.first : "#"}))
  let letters = flatten([["★"], unique(sort(bucketed.map(a => a.bucket)))])
  let rail = !searching && len(letters) > 2
  // A letter the tab doesn't have (its last app went) shows them all.
  let railed = rail && railLetter != null && contains(letters, railLetter) ? railLetter : null
  let mine = railed == null ? tabApps : bucketed.filter(a => a.bucket == railed)
  // Each letter's height on the rail, so all of them fit beside the list; the rail's own touches find the letter by it.
  let letterHeight = clamp(floor(((screenHeight ?? 600) - 80) / len(letters)), 8, 24)
  // Each section's id keys its rows; its title is the one shown.
  let sections = shown == "work" ? [
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "work", title: d.work.paused ? str.workPaused : str.workApps, apps: mine.filter(a => a.kind == "android"), work: true}
    ] : shown == "private" ? [
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "private", title: d.private.locked ? str.privateLocked : str.privateApps, apps: mine.filter(a => a.kind == "android"), private: true}
    ] : [
      {id: "apps", title: str.apps, apps: mine.filter(a => a.kind == "owl")},
      {id: "linux", title: str.linux, apps: mine.filter(a => a.kind == "linux"), linux: true},
      {id: "shortcuts", title: str.shortcuts, apps: mine.filter(a => a.kind == "shortcut")},
      {id: "android", title: str.android, apps: mine.filter(a => a.kind == "android")}
    ]
  // A title, then rows of cols apps. Without Linux, its section is an offer to install it. Under a rail letter only the
  // sections with its apps show.
  let rows = flatten(sections.filter(s => len(s.apps) > 0 || (railed == null && (s.work || s.private || (s.linux && !linux)))).map(s => flatten([
      [{key: "h:" + s.id, title: s.linux && !linux ? str.linuxApps : s.title, work: s.work, private: s.private, offer: s.linux && !linux}],
      chunk(s.apps, cols).map((cells, r) => {key: s.id + ":" + r, cells: cells})
    ])))
  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(d.apps, typed) : []
  // Typing "private" while the private space is locked offers to unlock it, as stock launchers do when it's hidden.
  let offersPrivate = searching && d.private != null && d.private.locked && len(typed) >= 3 && (startsWith("private space", lower(typed)) || startsWith(lower(str.privateSpace), lower(typed)))
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; anything else, a prompt of more lines among it, goes to the agent.
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  // What Enter acts on: a result by its place in hits, or -1 for the ask row.
  let chosen = pick ?? (opens ? 0 : -1)
  let agent = ag.default
  // With a keyboard: Up and Tab move the pick away from the bar, Down and Shift+Tab back; the ask row sits lowest.
  onKey: {
    if searching {
      pick = clamp(chosen + (value == "up" || value == "tab" ? 1 : -1), -1, len(hits) - 1)
    }
  }

  // Typing starts the pick over, at the best match, and searches every app, whatever letter the rail had.
  on typed {
    pick = null
    railLetter = null
  }

  // How much the drawer covers home: near-opaque, as home's widgets showing through make the icons hard to read.
  opacity: 0.97
  // keyboard: false (with owl: 15 in meta) leaves the keyboard down as the drawer opens, until the bar is tapped.
  enter: searching ? (chosen >= 0 ? "▸ " + str.open : "⏎ " + str.ask) : ""
  // An empty bar's Enter does nothing, as on home.
  onSubmit: {
    if searching {
      if chosen >= 0 {
        open(hits[chosen].key)
      } else if !linux {
        launcher("linux")
      } else {
        ask(value)
      }
    }
  }

  // An app's icon as the drawer draws it: its own, its silhouette on a badge with monochrome icons, or its initials.
  component AppIcon(a) {
    Box {
      size: 52 * scale
      align: center
      radius: 26 * scale * corners
      background: a.hasIcon && !d.monochrome ? transparent : surface
      if a.hasIcon {
        Image { src: a.icon; size: (d.monochrome ? 36 : 52) * scale; tint: d.monochrome ? accent : null; label: a.label }
      } else {
        Text { text: a.initials; fontSize: 18 * scale; color: accent }
      }
    }
  }

  component Cell(a, picked) {
    Column {
      weight: 1
      align: center
      gap: 6
      padding: [4, 10]
      radius: 16 * corners
      border: picked ? 2 : 0
      borderColor: accent
      // Paused work apps show dimmed; opening one turns work apps back on.
      opacity: a.paused ? 0.4 : 1
      onTap: {
        railLetter = null
        open(a.key)
      }
      onLongPress: {
        haptic()
        menuShortcuts = null
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }
      AppIcon { a: a }
      // Always two lines tall, so a row keeps its height whichever apps fill it.
      Text { visible: labels; text: a.name; fontSize: 12; align: center; maxLines: 2; minLines: 2; fill: width }
      Popup {
        visible: menu == a.key && menuShortcuts != null
        position: above
        onDismiss: menu = ""
        width: 200
        gap: 0
        // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
        for s in menuShortcuts key s.key {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [12, 6]
            onTap: { menu = ""; open(s.key) }
            Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
            Text { text: s.name; weight: 1; maxLines: 1 }
            // The private space's apps stay off home.
            Text { text: "[+]"; visible: a.profile != "private"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
          }
        }
        Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
        for w in a.actions {
          Text { text: get(str, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
        }
      }
    }
  }

  // A row of the list: a section's title, or a row of its apps.
  component DrawerRow(row) {
    Column {
      fill: width
      gap: 0
      if row.title != null {
        // A section's title, with the work switch, the private space's lock and buttons, or the offer to install Linux at its end.
        Column {
          fill: width
          gap: 0
          Row {
            fill: width
            gap: 8
            align: center
            padding: [8, 12, 0, 4]
            Text { text: row.title; color: muted; weight: 1 }
            Text { text: "[" + (d.work.paused ? str.turnOn : str.pause) + "]"; visible: row.work == true; color: accent; onTap: workApps("toggle") }
            // Unlocked: install apps into it, Android's settings for it (16 on), and the lock.
            Text { text: "[" + str.install + "]"; visible: row.private == true && !d.private.locked; color: accent; onTap: privateSpace("install") }
            Text { text: "[" + str.settings + "]"; visible: row.private == true && !d.private.locked && d.private.settings; color: accent; onTap: privateSpace("settings") }
            Text { text: "[" + (d.private.locked ? str.unlock : str.lock) + "]"; visible: row.private == true; color: accent; onTap: privateSpace("toggle") }
            Text { text: "[" + (d.linux == "installing" ? str.installing : d.linux == "off" ? str.startLinux : str.installLinux) + "]"; visible: row.offer == true; color: accent; onTap: launcher("linux") }
          }
          // Before Android 16 has a setting for it, the drawer keeps its own: hiding the tab while the space is locked.
          Row {
            visible: row.private == true && !d.private.locked && !d.private.settings
            fill: width
            gap: 8
            align: center
            padding: [8, 12, 0, 4]
            Text { text: str.hideWhileLocked; color: muted; weight: 1 }
            Text { text: "[" + (d.private.hidden ? str.shownOn : str.shownOff) + "]"; color: accent; onTap: privateSpace(d.private.hidden ? "show" : "hide") }
          }
        }
      } else {
        Row {
          fill: width
          gap: 0
          for a in row.cells { Cell { a: a; picked: false } }
          // A short last row keeps its cells the width of the others'.
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
  }

  Column {
    gap: 0
    padding: [12, 0]
    // Swiping sideways steps through the tabs: right to left from personal to work to private, and back.
    onSwipe: {
      if !searching {
        tab = tabs[clamp(indexOf(tabs, shown) + (value == "left" ? 1 : -1), 0, len(tabs) - 1)]
        railLetter = null
      }
    }
    Row {
      align: center
      padding: [0, 12, 0, 8]
      gap: 0
      // Typing searches every profile, so the tabs step aside.
      for t in len(tabs) > 1 && !searching ? tabs : [] {
        Text { text: get(str, t); color: shown == t ? accent : muted; background: shown == t ? surface : transparent; radius: 18 * corners; padding: [14, 10]; onTap: { tab = t; railLetter = null } }
      }
      // The rail's letter, parked here while it shows only its apps; a tap shows them all again.
      Text { visible: railed != null; text: upper(railed ?? ""); fontSize: 18; color: accent; background: surface; radius: 18 * corners; padding: [14, 8]; onTap: railLetter = null }
      Spacer { weight: 1 }
      Box {
        size: 44
        radius: 22 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: str.settings }
        // System updates are waiting: settings › system updates lists them.
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }
    // The list, with the letter rail at its side.
    Box {
      weight: 1
      fill: width
      align: center
      Row {
        fill: true
        gap: 0
        align: center
        Column {
          visible: !searching && railed == null
          lazy: true
          weight: 1
          fill: height
          gap: 0
          for row in rows key row.key { DrawerRow { row: row } }
        }
        // A letter's apps sit right above the bar, by the thumb, as search results do.
        Column {
          visible: !searching && railed != null
          lazy: true
          reverse: true
          weight: 1
          fill: height
          gap: 0
          for row in reverse(rows) key row.key { DrawerRow { row: row } }
        }
        Column {
          visible: searching
          lazy: true
          reverse: true
          weight: 1
          fill: height
          gap: 0
          for row in hitRows key row.key {
            Row {
              fill: width
              gap: 0
              for a, i in row.cells { Cell { a: a; picked: row.start + i == chosen } }
              for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
            }
          }
        }
        // The letter rail, as Niagara's: a touch or a drag along it shows only the apps under the letter beneath the
        // finger, ★ all of them again. Its letters are letterHeight tall, so where the finger is says which.
        Column {
          visible: rail
          width: railWidth
          height: letterHeight * len(letters)
          gap: 0
          drag: vertical
          ripple: false
          onPress: {
            let at = letters[clamp(floor(y / letterHeight), 0, len(letters) - 1)]
            railTouch = true
            if at != (railed ?? "★") {
              haptic()
              railLetter = at == "★" ? null : at
            }
          }
          onDrag: {
            let at = letters[clamp(floor(y / letterHeight), 0, len(letters) - 1)]
            railTouch = true
            if at != (railed ?? "★") {
              haptic()
              railLetter = at == "★" ? null : at
            }
          }
          // Takes the tap, which would close the drawer otherwise; onPress has picked the letter already.
          onTap: railTouch = false
          onRelease: railTouch = false
          onDragEnd: railTouch = false
          for l in letters key l {
            Box {
              height: letterHeight
              fill: width
              align: center
              Text { text: upper(l); fontSize: min(14, letterHeight * 0.7); maxLines: 1; color: l == (railed ?? "★") ? accent : muted }
            }
          }
        }
        Spacer { visible: !rail; width: railWidth }
      }
      // The letter big in the middle while the finger rides the rail.
      Text { visible: railTouch && railed != null; text: upper(railed ?? ""); fontSize: 96; color: accent; align: center; fill: width }
    }
    Row {
      visible: offersPrivate
      fill: width
      gap: 4
      padding: [12, 10]
      onTap: privateSpace("unlock")
      Text { text: "🔒"; color: muted }
      Text { text: str.unlockPrivate; color: foreground; weight: 1 }
    }
    // The one line above the bar that sends what's typed to the agent; outlined when that's what Enter does.
    Row {
      visible: searching
      fill: width
      gap: 4
      padding: [12, 10]
      border: chosen == -1 ? 2 : 0
      borderColor: accent
      radius: 16 * corners
      onTap: {
        if !linux {
          launcher("linux")
        } else if agent == null {
          launcher("agents")
        } else {
          ask(typed)
        }
      }
      Text { text: "⏎"; color: chosen == -1 ? accent : muted }
      Text {
        text: !linux ? str.askInstallLinux : agent == null ? str.askInstallAgent : str.askAgent(agent.bin, typed)
        color: chosen == -1 ? foreground : muted
        maxLines: 1
        weight: 1
      }
    }
  }
}
